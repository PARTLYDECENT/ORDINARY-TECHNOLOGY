<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cosmic Logic: The Dimensional Vault</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #0a0a0a;
            color: #f0f0f0;
            overflow: hidden;
        }
        
        .game-container {
            width: 100vw;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background-image: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)), url('/api/placeholder/1200/800');
            background-size: cover;
            background-position: center;
            position: relative;
        }
        
        .game-header {
            text-align: center;
            margin-bottom: 20px;
        }
        
        .game-title {
            font-size: 36px;
            margin-bottom: 10px;
            background: linear-gradient(to right, #3498db, #9b59b6);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            text-shadow: 0px 0px 10px rgba(52, 152, 219, 0.5);
        }
        
        .game-subtitle {
            font-size: 18px;
            color: #aaa;
            margin-bottom: 20px;
        }
        
        .puzzle-container {
            width: 800px;
            height: 600px;
            background-color: #111;
            border: 2px solid #333;
            border-radius: 10px;
            display: flex;
            position: relative;
            overflow: hidden;
            box-shadow: 0 0 20px rgba(52, 152, 219, 0.3);
        }
        
        .portal-side {
            width: 250px;
            height: 100%;
            background-color: #1a1a1a;
            border-right: 1px solid #333;
            display: flex;
            flex-direction: column;
            padding: 10px;
            box-sizing: border-box;
        }
        
        .energy-display {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
        }
        
        .energy-label {
            margin-right: 10px;
            color: #3498db;
        }
        
        .energy-bar {
            flex-grow: 1;
            height: 15px;
            background-color: #222;
            border-radius: 7px;
            overflow: hidden;
        }
        
        .energy-level {
            height: 100%;
            width: 100%;
            background: linear-gradient(to right, #3498db, #9b59b6);
            transition: width 0.3s;
        }
        
        .portal-tools {
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin-bottom: 20px;
        }
        
        .portal-tool {
            background-color: #222;
            padding: 10px;
            border-radius: 5px;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            border: 1px solid #333;
        }
        
        .portal-tool:hover {
            background-color: #2c3e50;
            border-color: #3498db;
        }
        
        .portal-tool.selected {
            background-color: #2c3e50;
            border-color: #9b59b6;
            box-shadow: 0 0 10px rgba(155, 89, 182, 0.5);
        }
        
        .tool-icon {
            width: 30px;
            height: 30px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-right: 10px;
            font-size: 18px;
        }
        
        .portal-notes {
            background-color: #222;
            padding: 10px;
            border-radius: 5px;
            margin-top: auto;
            font-size: 14px;
            border: 1px solid #333;
            height: 150px;
            overflow-y: auto;
        }
        
        .note-entry {
            margin-bottom: 10px;
            padding-bottom: 5px;
            border-bottom: 1px solid #333;
        }
        
        .puzzle-area {
            flex-grow: 1;
            height: 100%;
            position: relative;
            overflow: hidden;
        }
        
        .grid-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            grid-template-rows: repeat(5, 1fr);
            gap: 3px;
            padding: 10px;
            box-sizing: border-box;
        }
        
        .grid-cell {
            background-color: #1a1a1a;
            border: 1px solid #333;
            border-radius: 5px;
            position: relative;
            transition: all 0.2s;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
        }
        
        .grid-cell:hover {
            background-color: #222;
            box-shadow: 0 0 5px rgba(52, 152, 219, 0.5);
        }
        
        .cell-content {
            width: 80%;
            height: 80%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 24px;
            position: relative;
        }
        
        .node {
            width: 70%;
            height: 70%;
            border-radius: 50%;
            background: radial-gradient(circle at 30% 30%, #3498db, #2c3e50);
            position: relative;
            box-shadow: 0 0 10px rgba(52, 152, 219, 0.7);
        }
        
        .node.powered {
            background: radial-gradient(circle at 30% 30%, #9b59b6, #8e44ad);
            box-shadow: 0 0 15px rgba(155, 89, 182, 0.8);
        }
        
        .node.destination {
            background: radial-gradient(circle at 30% 30%, #f1c40f, #d35400);
            box-shadow: 0 0 15px rgba(241, 196, 15, 0.8);
        }
        
        .node.complete {
            background: radial-gradient(circle at 30% 30%, #2ecc71, #27ae60);
            box-shadow: 0 0 15px rgba(46, 204, 113, 0.8);
            animation: pulse 2s infinite;
        }
        
        @keyframes pulse {
            0% { box-shadow: 0 0 15px rgba(46, 204, 113, 0.8); }
            50% { box-shadow: 0 0 25px rgba(46, 204, 113, 1); }
            100% { box-shadow: 0 0 15px rgba(46, 204, 113, 0.8); }
        }
        
        .connector {
            position: absolute;
            background-color: #3498db;
            transition: all 0.3s;
            opacity: 0.7;
            z-index: -1;
        }
        
        .connector.horizontal {
            height: 10px;
            top: calc(50% - 5px);
        }
        
        .connector.vertical {
            width: 10px;
            left: calc(50% - 5px);
        }
        
        .connector.powered {
            background-color: #9b59b6;
            box-shadow: 0 0 10px rgba(155, 89, 182, 0.5);
            opacity: 1;
        }
        
        .dimension-filter {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            background-color: rgba(52, 152, 219, 0.1);
            z-index: 1;
            opacity: 0;
            transition: opacity 0.3s;
            pointer-events: none;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        
        .dimension-filter.active {
            opacity: 1;
        }
        
        .dimension-icon {
            font-size: 100px;
            color: rgba(255, 255, 255, 0.1);
        }
        
        .mirror {
            width: 60%;
            height: 60%;
            transform: rotate(45deg);
            background: linear-gradient(135deg, #777, #333);
            position: relative;
        }
        
        .mirror::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(255,255,255,0.5), rgba(255,255,255,0.1));
        }
        
        .splitter {
            width: 60%;
            height: 10px;
            background: linear-gradient(to right, #3498db, #9b59b6);
            position: relative;
        }
        
        .blocker {
            width: 70%;
            height: 70%;
            background-color: #c0392b;
            border-radius: 5px;
            position: relative;
        }
        
        .controls {
            margin-top: 20px;
            display: flex;
            gap: 15px;
        }
        
        .btn {
            background: linear-gradient(to bottom, #3498db, #2980b9);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: bold;
        }
        
        .btn:hover {
            background: linear-gradient(to bottom, #3498db, #1a5276);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(52, 152, 219, 0.4);
        }
        
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-color: rgba(0, 0, 0, 0.8);
            z-index: 100;
            justify-content: center;
            align-items: center;
        }
        
        .modal-content {
            width: 600px;
            background-color: #111;
            border: 2px solid #3498db;
            border-radius: 10px;
            padding: 30px;
            box-shadow: 0 0 30px rgba(52, 152, 219, 0.5);
            text-align: center;
        }
        
        .modal h2 {
            color: #3498db;
            margin-bottom: 20px;
        }
        
        .modal p {
            margin-bottom: 20px;
            line-height: 1.6;
        }
        
        .level-indicator {
            position: absolute;
            top: 20px;
            left: 20px;
            font-size: 18px;
            color: #3498db;
        }
        
        .popup-message {
            position: absolute;
            top: 70px;
            left: 0;
            right: 0;
            text-align: center;
            background-color: rgba(0, 0, 0, 0.7);
            padding: 15px;
            color: #3498db;
            opacity: 0;
            transition: opacity 0.3s;
            z-index: 50;
        }
    </style>
</head>
<body>
    <div class="game-container">
        <div class="game-header">
            <h1 class="game-title">COSMIC LOGIC: THE DIMENSIONAL VAULT</h1>
            <p class="game-subtitle">Manipulate energy flows between dimensions to unlock the ancient vault</p>
        </div>
        
        <div class="puzzle-container" id="puzzle-container">
            <div class="portal-side">
                <div class="energy-display">
                    <div class="energy-label">ENERGY:</div>
                    <div class="energy-bar">
                        <div class="energy-level" id="energy-level"></div>
                    </div>
                </div>
                
                <div class="portal-tools">
                    <div class="portal-tool" id="tool-node">
                        <div class="tool-icon">⚫</div>
                        <div>Energy Node</div>
                    </div>
                    <div class="portal-tool" id="tool-connector">
                        <div class="tool-icon">━</div>
                        <div>Connector</div>
                    </div>
                    <div class="portal-tool" id="tool-mirror">
                        <div class="tool-icon">◆</div>
                        <div>Mirror</div>
                    </div>
                    <div class="portal-tool" id="tool-splitter">
                        <div class="tool-icon">🔱</div>
                        <div>Splitter</div>
                    </div>
                    <div class="portal-tool" id="tool-dimension">
                        <div class="tool-icon">🌀</div>
                        <div>Dimension Shift</div>
                    </div>
                    <div class="portal-tool" id="tool-remove">
                        <div class="tool-icon">✖</div>
                        <div>Remove</div>
                    </div>
                </div>
                
                <div class="portal-notes" id="portal-notes">
                    <div class="note-entry">System initialized. Connect energy sources to destinations.</div>
                </div>
            </div>
            
            <div class="puzzle-area">
                <div class="level-indicator" id="level-indicator">LEVEL 1</div>
                <div class="popup-message" id="popup-message"></div>
                <div class="grid-container" id="grid-container"></div>
                <div class="dimension-filter" id="dimension-filter">
                    <div class="dimension-icon">🌀</div>
                </div>
            </div>
        </div>
        
        <div class="controls">
            <button class="btn" id="reset-btn">Reset Level</button>
            <button class="btn" id="help-btn">How to Play</button>
        </div>
        
        <div class="modal" id="help-modal">
            <div class="modal-content">
                <h2>HOW TO PLAY</h2>
                <p>Connect energy sources (blue nodes) to destination nodes (yellow) by creating a path of connectors and tools.</p>
                <p><strong>Energy Node:</strong> Creates a power source or receiver point.<br>
                <strong>Connector:</strong> Creates energy paths between nodes and tools.<br>
                <strong>Mirror:</strong> Reflects energy at a 90-degree angle.<br>
                <strong>Splitter:</strong> Divides energy flow into multiple paths.<br>
                <strong>Dimension Shift:</strong> Some connections only work across different dimensions.</p>
                <p>Each tool costs energy to place. Complete all paths to unlock the next level.</p>
                <button class="btn" id="close-help">I Understand</button>
            </div>
        </div>
        
        <div class="modal" id="win-modal">
            <div class="modal-content">
                <h2>LEVEL COMPLETE!</h2>
                <p id="win-message">You've successfully channeled the cosmic energy!</p>
                <p>The dimensional vault reveals its secrets...</p>
                <button class="btn" id="next-level">Next Level</button>
            </div>
        </div>
        
        <div class="modal" id="game-complete-modal">
            <div class="modal-content">
                <h2>DIMENSIONAL VAULT UNLOCKED!</h2>
                <p>You've mastered the cosmic energies and unlocked all the secrets of the dimensional vault.</p>
                <p>The ancient civilization's knowledge is now yours!</p>
                <button class="btn" id="restart-game">Play Again</button>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Game elements
            const gridContainer = document.getElementById('grid-container');
            const energyLevel = document.getElementById('energy-level');
            const portalTools = document.querySelectorAll('.portal-tool');
            const portalNotes = document.getElementById('portal-notes');
            const resetBtn = document.getElementById('reset-btn');
            const helpBtn = document.getElementById('help-btn');
            const helpModal = document.getElementById('help-modal');
            const closeHelpBtn = document.getElementById('close-help');
            const winModal = document.getElementById('win-modal');
            const gameCompleteModal = document.getElementById('game-complete-modal');
            const nextLevelBtn = document.getElementById('next-level');
            const restartGameBtn = document.getElementById('restart-game');
            const levelIndicator = document.getElementById('level-indicator');
            const popupMessage = document.getElementById('popup-message');
            const dimensionFilter = document.getElementById('dimension-filter');
            const winMessage = document.getElementById('win-message');
            
            // Game state
            let currentLevel = 1;
            let energy = 100;
            let selectedTool = null;
            let grid = [];
            let connections = [];
            let currentDimension = 1; // 1 or 2 for dimension shifting
            
            // Level configurations
            const levels = [
                // Level 1: Simple straight line connection
                {
                    energy: 100,
                    nodes: [
                        { x: 0, y: 2, type: 'source' },
                        { x: 4, y: 2, type: 'destination' }
                    ],
                    blockers: [],
                    hint: "Connect the source to the destination using connectors."
                },
                // Level 2: Using mirrors
                {
                    energy: 90,
                    nodes: [
                        { x: 0, y: 0, type: 'source' },
                        { x: 4, y: 4, type: 'destination' }
                    ],
                    blockers: [
                        { x: 2, y: 2 },
                        { x: 3, y: 2 },
                        { x: 2, y: 3 }
                    ],
                    hint: "Use mirrors to redirect energy flow around obstacles."
                },
                // Level 3: Multiple connections
                {
                    energy: 85,
                    nodes: [
                        { x: 0, y: 0, type: 'source' },
                        { x: 4, y: 0, type: 'destination' },
                        { x: 4, y: 4, type: 'destination' }
                    ],
                    blockers: [
                        { x: 2, y: 0 },
                        { x: 2, y: 1 },
                        { x: 2, y: 2 },
                        { x: 2, y: 3 }
                    ],
                    hint: "Use splitters to divide the energy flow to multiple destinations."
                },
                // Level 4: Dimension shifting
                {
                    energy: 80,
                    nodes: [
                        { x: 0, y: 0, type: 'source' },
                        { x: 4, y: 4, type: 'destination' }
                    ],
                    blockers: [
                        { x: 1, y: 1 }, { x: 2, y: 1 }, { x: 3, y: 1 },
                        { x: 1, y: 2 }, { x: 3, y: 2 },
                        { x: 1, y: 3 }, { x: 2, y: 3 }, { x: 3, y: 3 }
                    ],
                    dimensionBlockers: [
                        { x: 2, y: 2, dimension: 2 }
                    ],
                    hint: "Some paths only exist in other dimensions. Use dimension shifting to bypass obstacles."
                },
                // Level 5: Complex pathing
                {
                    energy: 75,
                    nodes: [
                        { x: 0, y: 0, type: 'source' },
                        { x: 0, y: 4, type: 'source' },
                        { x: 4, y: 0, type: 'destination' },
                        { x: 4, y: 4, type: 'destination' }
                    ],
                    blockers: [
                        { x: 2, y: 0 }, { x: 2, y: 1 },
                        { x: 0, y: 2 }, { x: 1, y: 2 }, { x: 2, y: 2 }, { x: 3, y: 2 }, { x: 4, y: 2 },
                        { x: 2, y: 3 }, { x: 2, y: 4 }
                    ],
                    dimensionBlockers: [
                        { x: 1, y: 1, dimension: 2 },
                        { x: 3, y: 1, dimension: 2 },
                        { x: 1, y: 3, dimension: 2 },
                        { x: 3, y: 3, dimension: 2 }
                    ],
                    hint: "Combine all your knowledge to solve this complex puzzle with multiple sources and destinations."
                }
            ];
            
            // Initialize the game
            function initGame() {
                createGrid();
                setupLevel(currentLevel);
                updateEnergyDisplay();
                
                // Set up event listeners
                portalTools.forEach(tool => {
                    tool.addEventListener('click', () => selectTool(tool));
                });
                
                resetBtn.addEventListener('click', resetLevel);
                helpBtn.addEventListener('click', showHelp);
                closeHelpBtn.addEventListener('click', hideHelp);
                nextLevelBtn.addEventListener('click', goToNextLevel);
                restartGameBtn.addEventListener('click', restartGame);
            }
            
            // Create the grid
            function createGrid() {
                gridContainer.innerHTML = '';
                grid = [];
                
                for (let y = 0; y < 5; y++) {
                    let row = [];
                    for (let x = 0; x < 5; x++) {
                        const cell = document.createElement('div');
                        cell.className = 'grid-cell';
                        cell.dataset.x = x;
                        cell.dataset.y = y;
                        
                        cell.addEventListener('click', () => {
                            handleCellClick(x, y);
                        });
                        
                        gridContainer.appendChild(cell);
                        row.push({
                            element: cell,
                            content: null,
                            type: null,
                            powered: false,
                            dimension: 1 // Default dimension
                        });
                    }
                    grid.push(row);
                }
            }
            
            // Set up a level
            function setupLevel(levelNum) {
                if (levelNum > levels.length) {
                    // Game complete
                    showGameCompleteModal();
                    return;
                }
                
                const level = levels[levelNum - 1];
                energy = level.energy;
                connections = [];
                currentDimension = 1;
                dimensionFilter.classList.remove('active');
                updateEnergyDisplay();
                
                // Reset grid
                for (let y = 0; y < 5; y++) {
                    for (let x = 0; x < 5; x++) {
                        const cell = grid[y][x];
                        cell.content = null;
                        cell.type = null;
                        cell.powered = false;
                        cell.dimension = 1;
                        cell.element.innerHTML = '';
                    }
                }
                
                // Place nodes
                level.nodes.forEach(node => {
                    const cell = grid[node.y][node.x];
                    cell.type = 'node';
                    cell.nodeType = node.type;
                    cell.powered = node.type === 'source';
                    
                    const nodeElement = document.createElement('div');
                    nodeElement.className = `node ${node.type === 'source' ? 'powered' : 'destination'}`;
                    cell.element.appendChild(nodeElement);
                    cell.content = nodeElement;
                });
                
                // Place blockers
                if (level.blockers) {
                    level.blockers.forEach(blocker => {
                        const cell = grid[blocker.y][blocker.x];
                        cell.type = 'blocker';
                        
                        const blockerElement = document.createElement('div');
                        blockerElement.className = 'blocker';
                        cell.element.appendChild(blockerElement);
                        cell.content = blockerElement;
                    });
                }
                
                // Set dimension blockers
                if (level.dimensionBlockers) {
                    level.dimensionBlockers.forEach(blocker => {
                        const cell = grid[blocker.y][blocker.x];
                        cell.type = 'blocker';
                        cell.dimension = blocker.dimension; // Only appears in specific dimension
                        
                        if (blocker.dimension === currentDimension) {
                            const blockerElement = document.createElement('div');
                            blockerElement.className = 'blocker';
                            cell.element.appendChild(blockerElement);
                            cell.content = blockerElement;
                        }
                    });
                }
                
                // Show level hint
                addNote(level.hint);
                showPopupMessage(`Level ${levelNum}: ${level.hint}`);
                levelIndicator.textContent = `LEVEL ${levelNum}`;
            }
            
            // Select a tool
            function selectTool(toolElement) {
                // Deselect previous tool
                portalTools.forEach(tool => tool.classList.remove('selected'));
                
                // Select new tool
                toolElement.classList.add('selected');
                selectedTool = toolElement.id;
                
                // Special case for dimension shifting
                if (selectedTool === 'tool-dimension') {
                    toggleDimension();
                    // Deselect after use
                    setTimeout(() => {
                        toolElement.classList.remove('selected');
                        selectedTool = null;
                    }, 300);
                    return;
                }
                
                showPopupMessage(`Selected: ${toolElement.textContent.trim()}`);
            }
            
            // Toggle between dimensions
            function toggleDimension() {
                currentDimension = currentDimension === 1 ? 2 : 1;
                
                // Visual effect for dimension shift
                dimensionFilter.classList.add('active');
                setTimeout(() => {
                    dimensionFilter.classList.remove('active');
                    
                    // Update grid to show/hide dimension-specific elements
                    updateDimensionView();
                    
                    addNote(`Shifted to dimension ${currentDimension}.`);
                    showPopupMessage(`Shifted to dimension ${currentDimension}`);
                }, 500);
            }
            
            // Update grid for current dimension
            function updateDimensionView() {
                for (let y = 0; y < 5; y++) {
                    for (let x = 0; x < 5; x++) {
                        const cell = grid[y][x];
                        
                        if (cell.type === 'blocker' && cell.dimension !== currentDimension) {
                            // Hide blockers from other dimensions
                            cell.element.innerHTML = '';
                            cell.content = null;
                        } else if (cell.type === 'blocker' && cell.dimension === currentDimension && !cell.content) {
                            // Show blockers for current dimension
                            const blockerElement = document.createElement('div');
                            blockerElement.className = 'blocker';
                            cell.element.appendChild(blockerElement);
                            cell.content = blockerElement;
                        }
                    }
                }
                
                // Also update power flow visualization
                propagatePower();
            }
            
            // Handle clicking on a grid cell
            function handleCellClick(x, y) {
                if (!selectedTool || selectedTool === 'tool-dimension') return;
                
                const cell = grid[y][x];
                
                // Can't place on blockers
                if (cell.type === 'blocker') {
                    showPopupMessage("Can't place items on obstacles!");
                    return;
                }
                
                // Can't place on existing nodes unless removing
                if (cell.type === 'node' && selectedTool !== 'tool-remove') {
                    showPopupMessage("Can't replace source or destination nodes!");
                    return;
                }
                
                // Remove existing item
                if (selectedTool === 'tool-remove') {
                    if (cell.type && cell.type !== 'node') {
                        // Refund some energy
                        energy += 5;
                        
                        // Remove connections to this cell
                        connections = connections.filter(conn => 
                            !(conn.x1 === x && conn.y1 === y) && 
                            !(conn.x2 === x && conn.y2 === y)
                        );
                        
                        // Clear cell
                        cell.element.innerHTML = '';
                        cell.type = null;
                        cell.content = null;
                        
                        updateEnergyDisplay();
                        addNote(`Item removed at position (${x}, ${y}).`);
                        propagatePower();
                    }
                    return;
                }
                
                // Check if enough energy
                if (energy < 10) {
                    showPopupMessage("Not enough energy!");
                    return;
                }
                
                // Place new item
                switch (selectedTool) {
                    case 'tool-node':
                        // Can only place nodes on empty cells
                        if (cell.type) {
                            showPopupMessage("Cell already occupied!");
                            return;
                        }
                        
             
						energy -= 15;
                        cell.type = 'node';
                        cell.nodeType = 'relay';
                        
                        const nodeElement = document.createElement('div');
                        nodeElement.className = 'node';
                        cell.element.appendChild(nodeElement);
                        cell.content = nodeElement;
                        
                        addNote(`Relay node placed at position (${x}, ${y}).`);
                        break;
                        
                    case 'tool-connector':
                        if (cell.type) {
                            showPopupMessage("Cell already occupied!");
                            return;
                        }
                        
                        energy -= 5;
                        cell.type = 'connector';
                        
                        // Check for adjacent nodes/connectors to connect to
                        const adjacentCells = getAdjacentCells(x, y);
                        const connectableCells = adjacentCells.filter(adj => 
                            adj && (adj.type === 'node' || adj.type === 'connector' || 
                                   adj.type === 'mirror' || adj.type === 'splitter')
                        );
                        
                        if (connectableCells.length === 0) {
                            showPopupMessage("Connectors must connect to something!");
                            energy += 5; // Refund energy
                            return;
                        }
                        
                        // Create connector element
                        const connectorElement = document.createElement('div');
                        connectorElement.className = 'cell-content';
                        cell.element.appendChild(connectorElement);
                        cell.content = connectorElement;
                        
                        // Create connections
                        connectableCells.forEach(adjCell => {
                            const adjX = grid.findIndex(row => row.includes(adjCell));
                            const adjY = grid[adjX].findIndex(c => c === adjCell);
                            
                            const conn = {
                                x1: x, y1: y,
                                x2: adjX, y2: adjY,
                                dimension: currentDimension
                            };
                            
                            connections.push(conn);
                            
                            // Visualize connection
                            const connector = document.createElement('div');
                            connector.className = 'connector';
                            
                            // Determine if horizontal or vertical
                            if (x === adjX) { // Vertical
                                connector.classList.add('vertical');
                                connector.style.height = '50%';
                                connector.style.top = y < adjY ? '50%' : '0';
                            } else { // Horizontal
                                connector.classList.add('horizontal');
                                connector.style.width = '50%';
                                connector.style.left = x < adjX ? '50%' : '0';
                            }
                            
                            connectorElement.appendChild(connector);
                        });
                        
                        addNote(`Connector placed at position (${x}, ${y}).`);
                        break;
                        
                    case 'tool-mirror':
                        if (cell.type) {
                            showPopupMessage("Cell already occupied!");
                            return;
                        }
                        
                        energy -= 20;
                        cell.type = 'mirror';
                        
                        const mirrorElement = document.createElement('div');
                        mirrorElement.className = 'mirror';
                        cell.element.appendChild(mirrorElement);
                        cell.content = mirrorElement;
                        
                        addNote(`Mirror placed at position (${x}, ${y}).`);
                        break;
                        
                    case 'tool-splitter':
                        if (cell.type) {
                            showPopupMessage("Cell already occupied!");
                            return;
                        }
                        
                        energy -= 25;
                        cell.type = 'splitter';
                        
                        const splitterElement = document.createElement('div');
                        splitterElement.className = 'splitter';
                        cell.element.appendChild(splitterElement);
                        cell.content = splitterElement;
                        
                        addNote(`Splitter placed at position (${x}, ${y}).`);
                        break;
                }
                
                updateEnergyDisplay();
                propagatePower();
                checkLevelComplete();
            }
            
            // Get adjacent cells (up, right, down, left)
            function getAdjacentCells(x, y) {
                return [
                    y > 0 ? grid[y-1][x] : null,              // up
                    x < grid[0].length - 1 ? grid[y][x+1] : null, // right
                    y < grid.length - 1 ? grid[y+1][x] : null,    // down
                    x > 0 ? grid[y][x-1] : null               // left
                ];
            }
            
            // Propagate power through the grid
            function propagatePower() {
                // Reset power state
                for (let y = 0; y < 5; y++) {
                    for (let x = 0; x < 5; x++) {
                        const cell = grid[y][x];
                        if (cell.type === 'node' && cell.nodeType === 'source') {
                            cell.powered = true;
                            if (cell.content) {
                                cell.content.classList.add('powered');
                            }
                        } else {
                            cell.powered = false;
                            if (cell.content) {
                                cell.content.classList.remove('powered');
                            }
                        }
                        
                        // Reset connectors
                        if (cell.content) {
                            const connectors = cell.content.querySelectorAll('.connector');
                            connectors.forEach(conn => conn.classList.remove('powered'));
                        }
                    }
                }
                
                // Find source nodes
                const sources = [];
                for (let y = 0; y < 5; y++) {
                    for (let x = 0; x < 5; x++) {
                        if (grid[y][x].type === 'node' && grid[y][x].nodeType === 'source') {
                            sources.push({x, y});
                        }
                    }
                }
                
                // Trace power from each source
                sources.forEach(source => {
                    tracePowerFlow(source.x, source.y, []);
                });
                
                // Check if destinations are powered
                let allDestinationsPowered = true;
                for (let y = 0; y < 5; y++) {
                    for (let x = 0; x < 5; x++) {
                        if (grid[y][x].type === 'node' && grid[y][x].nodeType === 'destination' && !grid[y][x].powered) {
                            allDestinationsPowered = false;
                        }
                    }
                }
                
                return allDestinationsPowered;
            }
            
            // Recursive function to trace power flow
            function tracePowerFlow(x, y, visited) {
                // Stop if we've already visited this cell or it's not in current dimension
                const key = `${x},${y}`;
                if (visited.includes(key)) return;
                visited.push(key);
                
                const cell = grid[y][x];
                cell.powered = true;
                
                if (cell.content) {
                    if (cell.type === 'node') {
                        cell.content.classList.add('powered');
                    }
                }
                
                // Find connections from this cell
                const cellConnections = connections.filter(conn => 
                    (conn.x1 === x && conn.y1 === y && conn.dimension === currentDimension) ||
                    (conn.x2 === x && conn.y2 === y && conn.dimension === currentDimension)
                );
                
                // Power flows through each connection
                cellConnections.forEach(conn => {
                    // Determine target cell
                    let targetX, targetY;
                    if (conn.x1 === x && conn.y1 === y) {
                        targetX = conn.x2;
                        targetY = conn.y2;
                    } else {
                        targetX = conn.x1;
                        targetY = conn.y1;
                    }
                    
                    // Power the connector visual
                    const sourceCell = grid[y][x];
                    if (sourceCell.content) {
                        const connectors = sourceCell.content.querySelectorAll('.connector');
                        connectors.forEach(connector => {
                            // Determine if this connector connects to the target
                            const isHorizontal = connector.classList.contains('horizontal');
                            const isVertical = connector.classList.contains('vertical');
                            
                            if ((isHorizontal && targetY === y) || (isVertical && targetX === x)) {
                                connector.classList.add('powered');
                            }
                        });
                    }
                    
                    // Continue power flow to next cell
                    const targetCell = grid[targetY][targetX];
                    
                    // Handle different target types
                    switch (targetCell.type) {
                        case 'node':
                        case 'connector':
                            tracePowerFlow(targetX, targetY, visited);
                            break;
                            
                        case 'mirror':
                            // Mirror reflects at 90 degrees
                            const dirX = targetX - x;
                            const dirY = targetY - y;
                            
                            // Find new direction (perpendicular)
                            let newDirX = dirY; // Swap and invert one component
                            let newDirY = -dirX;
                            
                            // Find next cell in reflection direction
                            const reflectX = targetX + newDirX;
                            const reflectY = targetY + newDirY;
                            
                            // Check if valid cell and has a connection
                            if (reflectX >= 0 && reflectX < 5 && reflectY >= 0 && reflectY < 5) {
                                const reflected = connections.some(c => 
                                    ((c.x1 === targetX && c.y1 === targetY && c.x2 === reflectX && c.y2 === reflectY) ||
                                     (c.x2 === targetX && c.y2 === targetY && c.x1 === reflectX && c.y1 === reflectY)) &&
                                    c.dimension === currentDimension
                                );
                                
                                if (reflected) {
                                    targetCell.powered = true;
                                    if (targetCell.content) {
                                        targetCell.content.classList.add('powered');
                                    }
                                    tracePowerFlow(reflectX, reflectY, visited);
                                }
                            }
                            break;
                            
                        case 'splitter':
                            // Splitter divides power to all connected cells
                            targetCell.powered = true;
                            if (targetCell.content) {
                                targetCell.content.classList.add('powered');
                            }
                            
                            // Find all connections from the splitter
                            const splitterConnections = connections.filter(conn => 
                                (conn.x1 === targetX && conn.y1 === targetY && 
                                !(conn.x2 === x && conn.y2 === y) && conn.dimension === currentDimension) ||
                                (conn.x2 === targetX && conn.y2 === targetY && 
                                !(conn.x1 === x && conn.y1 === y) && conn.dimension === currentDimension)
                            );
                            
                            // Continue power flow through each connection
                            splitterConnections.forEach(sConn => {
                                let nextX, nextY;
                                if (sConn.x1 === targetX && sConn.y1 === targetY) {
                                    nextX = sConn.x2;
                                    nextY = sConn.y2;
                                } else {
                                    nextX = sConn.x1;
                                    nextY = sConn.y1;
                                }
                                
                                tracePowerFlow(nextX, nextY, visited);
                            });
                            break;
                    }
                });
            }
            
            // Check if level is complete
            function checkLevelComplete() {
                // Check if all destinations are powered
                let allDestinationsPowered = true;
                let destinations = [];
                
                for (let y = 0; y < 5; y++) {
                    for (let x = 0; x < 5; x++) {
                        if (grid[y][x].type === 'node' && grid[y][x].nodeType === 'destination') {
                            destinations.push(grid[y][x]);
                            if (!grid[y][x].powered) {
                                allDestinationsPowered = false;
                            } else {
                                grid[y][x].content.classList.add('complete');
                            }
                        }
                    }
                }
                
                if (allDestinationsPowered && destinations.length > 0) {
                    setTimeout(() => {
                        showWinModal();
                    }, 1000);
                }
            }
            
            // Update energy display
            function updateEnergyDisplay() {
                energyLevel.style.width = `${energy}%`;
            }
            
            // Add a note to the portal notes
            function addNote(text) {
                const note = document.createElement('div');
                note.className = 'note-entry';
                note.textContent = text;
                portalNotes.appendChild(note);
                portalNotes.scrollTop = portalNotes.scrollHeight;
            }
            
            // Show popup message
            function showPopupMessage(message) {
                popupMessage.textContent = message;
                popupMessage.style.opacity = 1;
                
                setTimeout(() => {
                    popupMessage.style.opacity = 0;
                }, 3000);
            }
            
            // Show help modal
            function showHelp() {
                helpModal.style.display = 'flex';
            }
            
            // Hide help modal
            function hideHelp() {
                helpModal.style.display = 'none';
            }
            
            // Show win modal
            function showWinModal() {
                const level = levels[currentLevel - 1];
                winMessage.textContent = `Level ${currentLevel} complete! Energy remaining: ${energy}%`;
                winModal.style.display = 'flex';
            }
            
            // Show game complete modal
            function showGameCompleteModal() {
                gameCompleteModal.style.display = 'flex';
            }
            
            // Go to next level
            function goToNextLevel() {
                currentLevel++;
                winModal.style.display = 'none';
                setupLevel(currentLevel);
            }
            
            // Reset current level
            function resetLevel() {
                setupLevel(currentLevel);
                addNote(`Level ${currentLevel} reset.`);
                showPopupMessage("Level reset!");
            }
            
            // Restart the game
            function restartGame() {
                currentLevel = 1;
                gameCompleteModal.style.display = 'none';
                setupLevel(currentLevel);
            }
            
            // Initialize the game
            initGame();
        });
    </script>
</body>
